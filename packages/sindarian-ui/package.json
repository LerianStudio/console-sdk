{
  "name": "@lerianstudio/sindarian-ui",
  "version": "1.4.0-beta.6",
  "description": "Sindarian UI - A UI library for Midaz Console",
  "license": "ISC",
  "author": {
    "name": "Lerian Studio",
    "email": "contato@lerian.studio",
    "url": "https://lerian.studio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LerianStudio/console-sdk.git",
    "directory": "packages/sindarian-ui"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/esm/index.d.ts",
        "require": "./dist/index.d.ts"
      },
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "check-types": "tsc --noEmit && tsc -p tsconfig.storybook.json",
    "build": "npm run build:cjs && npm run build:esm && npm run copy:assets && npm run copy:styles",
    "build:cjs": "tsc && tsc-alias -p tsconfig.json && copyfiles -u 1 \"src/**/*.cjs\" \"src/**/*.d.cts\" \"src/**/*.json\" dist",
    "build:esm": "tsc -p tsconfig.esm.json && tsc-alias -p tsconfig.esm.json --resolve-full-paths && copyfiles -u 1 \"src/**/*.cjs\" \"src/**/*.d.cts\" \"src/**/*.json\" dist/esm && node -e \"require('fs').writeFileSync('dist/esm/package.json',JSON.stringify({type:'module'}))\" && node scripts/check-esm-output.mjs",
    "copy:assets": "copyfiles -f src/public/**/* dist/public",
    "copy:styles": "copyfiles -u 1 src/**/*.css dist",
    "lint": "eslint . --fix",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test": "jest",
    "test:e2e": "exit 0",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.21",
    "input-otp": "^1.4.2",
    "postcss": "^8.5.16",
    "qrcode.react": "^4.2.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "lodash": ">=4.17.0",
    "lucide-react": ">=0.536.0",
    "next": ">=14.0.0",
    "react": ">=19.0.0",
    "react-day-picker": ">=9.13.0",
    "react-dom": ">=19.0.0",
    "react-hook-form": ">=7.60.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "next": "^16.2.6",
    "storybook": "^10.4.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
